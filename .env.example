# Stripe test keys — https://dashboard.stripe.com/test/apikeys
# Copy this file to .env.local and restart `npm run dev`.
#
# Test card: 4242 4242 4242 4242, any future expiry, any CVC, any ZIP.
# Declines on charge:      4000 0000 0000 0341
# Requires authentication: 4000 0025 0000 3155

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

# The server refuses to start a charge with a live key unless this is set to 1.
# ALLOW_LIVE_STRIPE_KEY=0
