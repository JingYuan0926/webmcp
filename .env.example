# PageCTRL merchant application
#
# Copy this file to `.env.local`, replace every placeholder, then restart
# `npm run dev`. Never commit `.env.local` or paste real secrets into this file.
#
# Deployed architecture:
#   Merchant app:    Vercel or another Next.js host
#   Signing service: Render at https://api.pagecontrol.app

# ── Stripe test checkout ──────────────────────────────────────────────────

# Get a TEST secret key from https://dashboard.stripe.com/test/apikeys.
# Card details stay on Stripe's hosted page, so this app needs no Stripe
# publishable key.
STRIPE_SECRET_KEY=sk_test_replace_me

# Safety lock: PageCTRL refuses live Stripe keys unless this is explicitly 1.
ALLOW_LIVE_STRIPE_KEY=0

# Test card:              4242 4242 4242 4242
# Declined charge:        4000 0000 0000 0341
# Authentication needed: 4000 0025 0000 3155
# Use any future expiry, any CVC, and any postcode.

# ── Signed checkout: merchant app only ────────────────────────────────────

# Server-side URL for requesting and verifying short-lived approval grants.
PAGECONTROL_API_URL=https://api.pagecontrol.app

# Generate with `openssl rand -base64 32`.
# This exact value must also be PAGECONTROL_SERVICE_TOKEN on Render.
# Never rename it with NEXT_PUBLIC_ and never send it to browser code.
PAGECONTROL_SERVICE_TOKEN=replace_with_shared_random_secret

# ── Merchant dashboard ────────────────────────────────────────────────────

# The public demo defaults to q / q. Replace both for any real deployment.
PAGECONTROL_DASHBOARD_USERNAME=q
PAGECONTROL_DASHBOARD_PASSWORD=q

# Generate a DIFFERENT value with `openssl rand -base64 32`.
# This signs and encrypts dashboard session cookies. It belongs only in the
# merchant app environment; do not copy it to Render.
PAGECONTROL_DASHBOARD_SESSION_SECRET=replace_with_separate_random_secret

# ── Safe browser display values ───────────────────────────────────────────

# These values contain no credentials. The dashboard uses them for status
# and setup guidance only.
NEXT_PUBLIC_PAGECONTROL_API_URL=https://api.pagecontrol.app
NEXT_PUBLIC_PAGECONTROL_ALLOWED_ORIGIN=https://webmcp-nine.vercel.app

# The origin above must match one exact entry in PAGECONTROL_ALLOWED_ORIGINS
# on Render. Render performs the real origin check.

# ── Optional merchant controls ────────────────────────────────────────────

# Independent shop-server session budget in minor units. The default is
# 30000 ($300.00). The server enforces this separately from the browser SDK.
# PAGECONTROL_SESSION_BUDGET_MINOR=30000

# ── Local checkout note ───────────────────────────────────────────────────

# Render signs only for origins in PAGECONTROL_ALLOWED_ORIGINS. Checkout from
# http://localhost:3000 will return origin_not_permitted unless that exact
# origin is temporarily allowed. The security demo, policies, tool audit,
# injection detection, and tamper guard still work locally without it.
