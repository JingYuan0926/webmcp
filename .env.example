# Stripe test key — https://dashboard.stripe.com/test/apikeys
# Copy this file to .env.local and restart `npm run dev`.
#
# Cards are saved on Stripe's own hosted setup page, so the browser never
# loads Stripe.js and no publishable key is needed.
#
# Test card: 4242 4242 4242 4242, any future expiry, any CVC, any ZIP.
# Declines on charge:      4000 0000 0000 0341
# Requires authentication: 4000 0025 0000 3155

STRIPE_SECRET_KEY=sk_test_replace_me

# The server refuses to charge with a live key unless this is set to 1.
# ALLOW_LIVE_STRIPE_KEY=0

# Server-only PageControl signing service configuration. Never prefix either
# value with NEXT_PUBLIC_ and never send the service token to the browser.
PAGECONTROL_API_URL=https://api.pagecontrol.app
PAGECONTROL_SERVICE_TOKEN=replace_with_railway_service_token

# Public display value for the merchant dashboard. Match this to the exact
# PAGECONTROL_ALLOWED_ORIGINS value configured on the signing service.
NEXT_PUBLIC_PAGECONTROL_ALLOWED_ORIGIN=https://webmcp-nine.vercel.app

# Independent shop-server spending cap in minor currency units ($300.00).
PAGECONTROL_SESSION_BUDGET_MINOR=30000
